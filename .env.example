# Supabase TiendaPro 3.0 — proyecto autorizado dnptsudsxrcamtxfiszh
# Dashboard: https://supabase.com/dashboard/project/dnptsudsxrcamtxfiszh/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://dnptsudsxrcamtxfiszh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (merge carrito anónimo, tareas admin legacy). No exponer en cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (redirects de auth, recovery). Preview Vercel: URL del deployment.
# NEXT_PUBLIC_SITE_URL=https://<preview>.vercel.app
NEXT_PUBLIC_SITE_URL=

# Persistencia plataforma SaaS (/app, /control con RLS). Activar SOLO tras validar login en Preview.
# Activar checkout solo Preview (Production requiere TIENDAPRO_CHECKOUT_PRODUCTION=1 además)
TIENDAPRO_CHECKOUT_ENABLED=
# TIENDAPRO_PLATFORM_DB=1

# Instalador (solo servidor — nunca NEXT_PUBLIC). Tokens con permiso mínimo y revocable.
# INSTALLER_GITHUB_TOKEN=
# INSTALLER_VERCEL_TOKEN=
# INSTALLER_VERCEL_TEAM_ID=
# INSTALLER_SUPABASE_ACCESS_TOKEN=
# Validación: restringe vínculos a recursos TiendaPro (0 = permitir cualquier recurso accesible por token)
# INSTALLER_AUTHORIZED_ONLY=1
# Provisionamiento cloud real (repo nuevo, Supabase, deploy). Desactivado por defecto.
# INSTALLER_ALLOW_PROVISION=0

# Runtime branding plantilla independiente (JSON en una línea). Alternativa a leer branding_config en BD.
# STORE_BRANDING_JSON=
# STORE_INDEPENDENT=1
# TIENDAPRO_INSTALLATION_SLUG=tiendapro-reference
