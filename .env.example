# Supabase TiendaPro 3.0 — proyecto autorizado dnptsudsxrcamtxfiszh
# Dashboard: https://supabase.com/dashboard/project/dnptsudsxrcamtxfiszh/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://dnptsudsxrcamtxfiszh.supabase.co
# Preferir publishable (Settings → API Keys). Fallback legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Preferir secret (sb_secret_…). Fallback legacy service_role JWT.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional local: smoke E2E contra prod (scripts/gate3f-e2e-prod.mjs) sin cambiar .env.local de dev.
# SUPABASE_SERVICE_ROLE_KEY_PROD=

# URL pública del sitio (redirects de auth, recovery). Preview Vercel: URL del deployment.
# NEXT_PUBLIC_SITE_URL=https://<preview>.vercel.app
NEXT_PUBLIC_SITE_URL=

# Persistencia plataforma SaaS (/app, /control con RLS). Activar SOLO tras validar login en Preview.
# Activar checkout solo Preview (Production requiere TIENDAPRO_CHECKOUT_PRODUCTION=1 además)
TIENDAPRO_CHECKOUT_ENABLED=
# Launch Track Facebook/Messenger (webhook + bot). Default off.
# TIENDAPRO_FACEBOOK_SALES_ENABLED=1
# Launch Track WhatsApp Cloud API (webhook + bot). Default off.
# TIENDAPRO_WHATSAPP_SALES_ENABLED=1
# Meta (solo servidor — nunca NEXT_PUBLIC_*):
# META_APP_SECRET=
# META_MESSENGER_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=
# WhatsApp Cloud API (misma app Meta o dedicada):
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# TIENDAPRO_PLATFORM_DB=1

# Puente operativo v1 — solo servidor (Custom GPT / integraciones). Mín. 24 caracteres; recomendado 32+ aleatorio.
# BRIDGE_API_SECRET=

# Cifrado de credenciales de integraciones (solo servidor). Mín. 32 caracteres aleatorios.
# INTEGRATION_CREDENTIALS_KEY=

# Mercado Pago OAuth (Gate 3G — solo servidor)
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_REDIRECT_URI=https://www.tiendapro.net/api/integrations/mercado-pago/callback

# Gate 3H — Checkout Pro Orders API (solo servidor; no activa Pack 150 por sí solo)
# TIENDAPRO_MP_ORDERS_CHECKOUT_ENABLED=1
# MERCADOPAGO_WEBHOOK_SECRET=
# Smoke privado Pack 150 + MP (Preview; requiere también TIENDAPRO_DIGITAL_SMOKE_ENABLED=1 y admin)
# TIENDAPRO_DIGITAL_SMOKE_ENABLED=1

# M&M Centro de Control (solo servidor — mismo valor que MM_TIENDAPRO_CONTROL_BRIDGE_SECRET en Worker M&M)
# MM_CONTROL_API_BASE_URL=https://mente-maestra.tiendapro-net-2026.workers.dev
# MM_TIENDAPRO_CONTROL_BRIDGE_SECRET=

# Opcional: PAT con issues:write + comentarios en PR del repo tienda-web (despacho + informes).
# GITHUB_BRIDGE_TOKEN=

# Instalador (solo servidor — nunca NEXT_PUBLIC). Tokens con permiso mínimo y revocable.
# INSTALLER_GITHUB_TOKEN=
# INSTALLER_VERCEL_TOKEN=
# INSTALLER_VERCEL_TEAM_ID=
# INSTALLER_SUPABASE_ACCESS_TOKEN=
# Validación: allowlist global siempre activa; autorización adicional por grant en Control.
# INSTALLER_AUTHORIZED_ONLY=1
# Provisionamiento cloud real (repo nuevo, Supabase, deploy). Desactivado por defecto.
# INSTALLER_ALLOW_PROVISION=0

# Runtime branding plantilla independiente (JSON en una línea). Alternativa a leer branding_config en BD.
# STORE_BRANDING_JSON=
# STORE_INDEPENDENT=1
# TIENDAPRO_INSTALLATION_SLUG=tiendapro-reference
